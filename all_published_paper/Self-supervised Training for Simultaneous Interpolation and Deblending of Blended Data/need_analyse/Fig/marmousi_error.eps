 0.24 0.24 scale gsave
 1 setlinecap 1 setlinejoin
 
systemdict /colorimage known not { 
  /colortograyscale { 
    dup /rgbdata exch store 
    length 3 idiv 
    /npixls exch store 
    /indx 0 store 
    /pixls npixls string store 
    0 1 npixls -1 add { 
      pixls exch 
      rgbdata indx get .3 mul 
      rgbdata indx 1 add get .59 mul add 
      rgbdata indx 2 add get .11 mul add 
      cvi 
  put 
      /indx indx 3 add store 
    } for 
    pixls 
  } bind def 
  /mergeprocs { 
    dup length 
    3 -1 roll 
    dup 
    length 
    dup 
    5 1 roll 
    3 -1 roll 
    add 
    array cvx 
    dup 
    3 -1 roll 
    0 exch 
    putinterval 
    dup 
    4 2 roll 
    putinterval 
  } bind def 
  /colorimage { 
     pop 
     pop 
     {colortograyscale} 
     mergeprocs 
     image 
  } bind def 
} if 
 
